// Autorización de ejecución privilegiada para los usuarios de `wheel`.
//
// REGLA DE ORO: autorizar por RUTA ABSOLUTA exacta, nunca por basename ni por
// comodín de nombre. pkexec resuelve rutas relativas (`./x`, `../x`) y busca
// en $PATH, así que un comodín tipo `^churros-[\w-]+$` sobre el basename
// concede root sin contraseña a cualquier fichero que el usuario pueda crear
// en su home o en un directorio de su $PATH.
//
// La lista es cerrada y todas las rutas viven bajo /usr o /usr/local, que son
// propiedad de root y no escribibles por el usuario. No se autoriza ningún
// wrapper genérico (`churros-pkexec`), porque reenviaría argumentos libres a
// pkexec y anularía esta misma lista.

polkit.addRule(function(action, subject) {
    // NOTA: no usar subject.active — en sesiones de greetd/niri puede
    // devolver false y pkexec falla sin agente. Se comprueba el grupo
    // wheel (usuarios administradores), que es el criterio estándar.
    if (!subject.local || !subject.isInGroup("wheel")) {
        return polkit.Result.NOT_HANDLED;
    }

    if (action.id == "io.calamares.calamares.pkexec.run" &&
        subject.user == "churros") {
        return polkit.Result.YES;
    }

    if (action.id != "org.freedesktop.policykit.exec") {
        return polkit.Result.NOT_HANDLED;
    }

    var cmd = "";
    try {
        if (typeof action.lookup === "function") {
            cmd = action.lookup("command") || "";
        }
        if (!cmd && typeof action.getDetails === "function") {
            cmd = action.getDetails() || "";
        }
        if (cmd && typeof cmd === "object" && cmd["command"]) {
            cmd = cmd["command"];
        }
    } catch (e) {
        cmd = "";
    }

    cmd = String(cmd || "").replace(/^\s+/, "");

    // Todo lo autorizado es una ruta absoluta: se descarta cualquier ruta
    // relativa o nombre desnudo (pkexec las resolvería contra $PATH).
    if (cmd.indexOf("/") !== 0) {
        return polkit.Result.NOT_HANDLED;
    }

    // Separación por espacios en blanco. No hay sintaxis de comillas en la
    // línea de órdenes de pkexec, así que un argumento con espacio solo puede
    // haber sido quoted por el cliente; en ese caso no coincide con la
    // allowlist y se deniega, que es el comportamiento correcto.
    var argv = cmd.split(/\s+/);
    var prog = argv[0];

    // pkexec no entrecomilla al componer la línea de órdenes, pero algunos
    // clientes sí lo hacen: se normaliza quitando comillas envolventes antes
    // de validar (nunca se reinterpreta el contenido).
    function unquote(a) {
        if (a.length >= 2) {
            var f = a.charAt(0), l = a.charAt(a.length - 1);
            if ((f === "'" && l === "'") || (f === '"' && l === '"')) {
                return a.slice(1, -1);
            }
        }
        return a;
    }

    var args = argv.slice(1).map(unquote);

    // Argumentos que convertirían una utilidad en un vector de escalada
    // (pacman --hookdir/--config/--dbpath, btrfs/churros-snapshot con rutas
    // arbitrarias, etc.).
    var FORBIDDEN = [
        "--hookdir", "--config", "--dbpath", "--cachedir", "--gpgdir",
        "--root", "--sysroot", "--arch", "--config-file", "--color",
        "-C", "--target", "--mount", "--o", "--options", "-o"
    ];

    function hasForbidden() {
        for (var i = 0; i < args.length; i++) {
            for (var j = 0; j < FORBIDDEN.length; j++) {
                if (args[i] === FORBIDDEN[j]) {
                    return true;
                }
            }
            // Cualquier ruta absoluta o con .. en un argumento es sospechosa.
            if (args[i].indexOf("/") === 0 || args[i].indexOf("../") === 0) {
                return true;
            }
        }
        return false;
    }

    function isColor(arg) {
        return /^#[0-9A-Fa-f]{6}([0-9A-Fa-f]{2})?$/.test(arg);
    }

    // -S / -Sy / -Syu / -R / -Q y paquetes. Se rechazan las opciones
    // estructurales del propio pacman para que el binario no pueda redirigir
    // sus ganchos, base de datos o caché a rutas controladas por el usuario.
    var PACMAN_OPS = ["-S", "-Sy", "-Syy", "-Syu", "-R", "-Sc", "-Q", "-Qs"];
    var PACMAN_FLAGS = ["--noconfirm", "-y", "--needed", "--asdeps"];

    function pacmanOk() {
        var opSeen = false;
        for (var i = 0; i < args.length; i++) {
            var a = args[i];
            if (a === "--") {
                return false;
            }
            var isOp = PACMAN_OPS.indexOf(a) !== -1;
            var isFlag = PACMAN_FLAGS.indexOf(a) !== -1;
            if (isOp) {
                opSeen = true;
                continue;
            }
            if (isFlag) {
                continue;
            }
            // Debe ser un nombre de paquete: no empieza por - y no contiene
            // rutas ni separadores de versión.
            if (a.charAt(0) === "-" || /[\/=]/.test(a)) {
                return false;
            }
        }
        return opSeen;
    }

    // churros-snapshot: solo verbos conocidos y stamps con formato fijo.
    function snapshotOk() {
        if (args.length === 0) {
            return false;
        }
        var verb = args[0];
        var known = ["create", "list", "info", "delete", "cleanup", "restore"];
        if (known.indexOf(verb) === -1) {
            return false;
        }
        var stamp = /^\d{8}-\d{6}$/;
        // Razón de `create`: texto libre usado como etiqueta en meta.txt.
        // Se restringe a un alfabeto inocuo para que no pueda inyectar
        // líneas extra en ese fichero.
        var reason = /^[A-Za-z0-9._:@%+=,-]+$/;
        var rest = args.slice(1);
        for (var i = 0; i < rest.length; i++) {
            if (rest[i] === "--json" || rest[i] === "--plain" || rest[i] === "-p") {
                continue;
            }
            if (/^\\d{1,3}$/.test(rest[i])) {
                continue;
            }
            if (stamp.test(rest[i]) || reason.test(rest[i])) {
                continue;
            }
            return false;
        }
        return true;
    }

    // timedatectl: solo las operaciones de reloj/zona horaria, nunca el resto
    // de sus subcomandos.
    var TIMEDATECTL_OPS = [
        "set-time", "set-timezone", "set-local-rtc", "set-ntp",
        "show", "status", "list-timezones", "show-timesync"
    ];

    function timedatectlOk() {
        if (args.length === 0) {
            return TIMEDATECTL_OPS.indexOf("status") !== -1;
        }
        return TIMEDATECTL_OPS.indexOf(args[0]) !== -1;
    }

    if (hasForbidden()) {
        return polkit.Result.NOT_HANDLED;
    }

    switch (prog) {
    case "/usr/bin/pacman":
        return pacmanOk() ? polkit.Result.YES : polkit.Result.NOT_HANDLED;
    case "/usr/bin/flatpak":
    case "/usr/bin/yay":
    case "/usr/bin/paru":
        return polkit.Result.YES;
    case "/usr/bin/timedatectl":
        return timedatectlOk() ? polkit.Result.YES : polkit.Result.NOT_HANDLED;
    case "/usr/bin/churros-update-utils":
        return polkit.Result.YES;
    case "/usr/local/bin/churros-write-root-config":
        // El helper valida el destino contra su propia lista cerrada y lee
        // el contenido de stdin: un único argumento.
        return args.length === 1 ? polkit.Result.YES : polkit.Result.NOT_HANDLED;
    case "/usr/local/bin/churros-snapshot":
        return snapshotOk() ? polkit.Result.YES : polkit.Result.NOT_HANDLED;
    case "/usr/local/bin/churros-theme":
        // Solo sin argumentos: escribe en $HOME/.cache, cualquier ruta extra
        // no aporta nada y ensucia la comprobacion.
        return args.length === 0 ? polkit.Result.YES : polkit.Result.NOT_HANDLED;
    case "/usr/share/churros/scripts/set-accent":
        return (args.length <= 1 && (args.length === 0 || isColor(args[0])))
            ? polkit.Result.YES : polkit.Result.NOT_HANDLED;
    default:
        return polkit.Result.NOT_HANDLED;
    }
});