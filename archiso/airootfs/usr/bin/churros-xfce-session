#!/usr/bin/env bash
# Wrapper to launch XFCE correctly from Greetd
#
# Flujo:
#   greetd → churros-xfce-session → startx → Xorg → churros-xfce-session --xinit → xfce4-session
#
# Problema raíz: startxfce4 de XFCE 4.20 detecta que no hay $DISPLAY
# (porque xinit lo inyecta tarde o se pierde en la cadena) y lanza su
# propio xinit interno, creando un bucle recursivo. Para evitarlo,
# llamamos directamente a xfce4-session (que es lo que startxfce4
# ejecuta al final de su xinitrc) y configuramos el entorno nosotros.

LOG="/tmp/churros-xfce-session.log"
echo "$(date): churros-xfce-session invoked with args: $*" >> "$LOG"
echo "  DISPLAY=${DISPLAY:-<unset>} WAYLAND_DISPLAY=${WAYLAND_DISPLAY:-<unset>} XDG_VTNR=${XDG_VTNR:-<unset>}" >> "$LOG"

# =====================================================================
# FASE CLIENTE (--xinit): Xorg ya está corriendo, lanzar la sesión XFCE
# =====================================================================
if [ "$1" = "--xinit" ]; then
    echo "$(date): --xinit mode (DISPLAY=$DISPLAY)" >> "$LOG"

    # Blindar el entorno: forzar X11 sin importar lo que PAM/systemd digan
    unset WAYLAND_DISPLAY
    unset XFCE4_SESSION_COMPOSITOR
    export XDG_SESSION_TYPE=x11
    export XDG_CURRENT_DESKTOP=XFCE
    export XDG_SESSION_DESKTOP=xfce

    # Cursor visible en VMs (evita el bug de cursor invisible en QEMU)
    xsetroot -cursor_name left_ptr || true

    # Cargar recursos X del sistema (xrdb, xmodmap, etc.)
    if [ -f /etc/X11/xinit/xinitrc ]; then
        . /etc/X11/xinit/xinitrc
    fi

    # Ejecutar directamente xfce4-session. NO llamamos a startxfce4
    # porque su lógica interna de detección de compositor/xinit causa
    # un bucle recursivo cuando no detecta $DISPLAY a tiempo.
    echo "$(date): exec xfce4-session" >> "$LOG"
    exec xfce4-session
fi

# =====================================================================
# FASE PADRE: preparar entorno y arrancar Xorg vía startx
# =====================================================================

# Limpiar variables residuales del greeter Wayland (cage)
unset WAYLAND_DISPLAY
unset DISPLAY

export XDG_CURRENT_DESKTOP=XFCE
export XDG_SESSION_DESKTOP=xfce
export XDG_SESSION_TYPE=x11

# VT que greetd asignó (evita colisión con cage)
VT="${XDG_VTNR:-7}"
echo "$(date): Starting Xorg on vt${VT}" >> "$LOG"

# Esperar a que cage libere el DRM master
sleep 1

exec startx "$0" --xinit -- :"0" "vt${VT}"
