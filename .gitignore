*.iso
*.img
*.qcow2
*.log
*.tmp
.cache/
work/
out/
build/
__pycache__/
*.pyc
*.pyo

# Editor / IDE
.vscode/

# QEMU EFI vars (local VM state)
vm/OVMF_VARS.fd

# Misc local notes accidentally committed
session-*.md

# Local pacman repo: built packages and repo databases.
# These are produced by scripts/build-calamares.sh and scripts/build-aur.sh
# and are not part of the source tree — each developer rebuilds them locally.
archiso/packages/*.pkg.tar.zst
archiso/packages/churros.db
archiso/packages/churros.db.tar.gz
archiso/packages/churros.db.tar.gz.old
archiso/packages/churros.files
archiso/packages/churros.files.tar.gz
archiso/packages/churros.files.tar.gz.old
archiso/packages/.calamares-build.stamp

# Rust workspace: build artifacts and deployed binaries.
# Produced by scripts/build-rust.sh — binaries land in the airootfs tree
# only during a build and are removed by the cleanup trap.
rust/**/target/
archiso/airootfs/usr/bin/churros-welcome
archiso/airootfs/usr/bin/churros-settings
archiso/airootfs/usr/bin/churros-popup
archiso/airootfs/usr/bin/churros-control-center

# Rust apps' runtime assets copied by scripts/build-rust.sh
archiso/airootfs/usr/share/churros/churros-welcome/
archiso/airootfs/usr/share/churros/churros-settings/
archiso/airootfs/usr/share/churros/churros-popup/
archiso/airootfs/usr/share/churros/churros-control-center/

# Release bundles produced by scripts/build-churros-release.sh
release/
