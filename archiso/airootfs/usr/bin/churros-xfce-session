#!/usr/bin/env bash
# Wrapper to launch XFCE correctly from Greetd

LOGFILE="${HOME:-/tmp}/.xsession-errors"
touch "$LOGFILE" 2>/dev/null && exec >> "$LOGFILE" 2>&1
echo "=== churros-xfce-session: start $(date) (pid=$$, arg1='${1:-}', DISPLAY='${DISPLAY:-}', WAYLAND='${WAYLAND_DISPLAY:-}') ==="

export XCURSOR_THEME="${XCURSOR_THEME:-Adwaita}"
export XCURSOR_SIZE="${XCURSOR_SIZE:-24}"
export XDG_CURRENT_DESKTOP=XFCE
export XDG_SESSION_DESKTOP=xfce
export XDG_SESSION_TYPE=x11
export DESKTOP_SESSION=xfce

# ¿Ya hay un servidor X? Pasa con nuestro propio startx (--xinit) y también
# cuando ReGreet lanza la sesión X11: antepone su x11_prefix por defecto
# ("startx /usr/bin/env") al Exec de xfce.desktop. Lanzar otro startx aquí
# fallaría ("Server is already active for display 0") y devolvería al greeter.
x_running() {
    [ -n "${DISPLAY:-}" ] || return 1
    command -v xset >/dev/null 2>&1 || return 0
    xset q >/dev/null 2>&1
}

if [ "${1:-}" = "--xinit" ] || x_running; then
    # Blindar el entorno X11: limpiar residuos de Wayland y variables que activan
    # la búsqueda de labwc en XFCE 4.20
    unset WAYLAND_DISPLAY
    unset XFCE4_SESSION_COMPOSITOR
    export XDG_SESSION_TYPE=x11
    export XDG_CURRENT_DESKTOP=XFCE
    export XDG_SESSION_DESKTOP=xfce
    export DESKTOP_SESSION=xfce

    # Forzar el dibujado del cursor por defecto en Xorg para evitar que sea invisible en VMs
    xsetroot -cursor_name left_ptr || true

    # Cargar recursos X si existen (sin ejecutar xinitrc, ya que contiene 'exec xterm' por defecto y mata la sesión)
    if command -v xrdb >/dev/null 2>&1; then
        [ -f /etc/X11/Xresources ] && xrdb -merge /etc/X11/Xresources 2>/dev/null || true
        [ -f "$HOME/.Xresources" ] && xrdb -merge "$HOME/.Xresources" 2>/dev/null || true
    fi

    # CRÍTICO: Ejecutar directamente xfce4-session en lugar de startxfce4.
    # En XFCE 4.20, startxfce4 detecta erróneamente Wayland y busca labwc,
    # fallando con 'Please either install labwc or specify another compositor'.
    # Como el servidor Xorg ya está activo, lanzamos directamente el gestor de sesión.
    exec /usr/bin/xfce4-session
fi

# Limpiar variables residuales del greeter (Wayland) que confunden a startx
unset WAYLAND_DISPLAY
unset DISPLAY

# Determinar el VT que greetd asignó a esta sesión (evita colisión con cage)
VT="${XDG_VTNR:-7}"

if command -v startx >/dev/null 2>&1; then
    # Esperar un segundo para permitir que cage libere el DRM master antes de que Xorg lo reclame
    sleep 1
    exec startx "$0" --xinit -- :0 "vt${VT}" -keeptty
else
    exec /usr/bin/xfce4-session
fi
