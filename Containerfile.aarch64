# Containerfile.aarch64 — build nativo de la ISO aarch64.
#
# Cuando TARGET_ARCH=aarch64, ./churros build --container construye esta
# imagen con --platform linux/arm64 y ejecuta dentro TODO el build: paquetes
# locales (makepkg), Rust y mkarchiso/pacstrap. En un host x86_64 el motor la
# corre con qemu-user (binfmt). En un host aarch64 corre nativa, sin emulación.
# El keyring, la arquitectura de los paquetes y pacman.conf son los de Arch
# Linux ARM; no hace falta un toolchain cruzado.
#
# ./churros rust en ARM sigue usando Containerfile (sin archiso). No cambies
# esa ruta: Arch Linux ARM no empaqueta archiso y el job de rust no lo necesita.
#
# archiso es arch=('any') en extra de Arch Linux. Sus dependencias sí están
# en ALARM, así que aquí se instala con pacman -U tras confiar el keyring de
# Arch. grub sale de ALARM e incluye los módulos arm64-efi.

ARG BASE_IMAGE=docker.io/menci/archlinuxarm:latest
FROM ${BASE_IMAGE}

# pacman no puede aplicar su sandbox de Landlock dentro del contenedor.
RUN grep -q '^DisableSandboxFilesystem' /etc/pacman.conf \
    || sed -i '/^\[options\]/a DisableSandboxFilesystem' /etc/pacman.conf

# Keyring de Arch Linux ARM (repos de la imagen y de la ISO) y el de Arch
# (firma el paquete archiso de extra).
RUN pacman-key --init \
    && pacman-key --populate archlinuxarm \
    && pacman -Sy --noconfirm --needed archlinuxarm-keyring archlinux-keyring \
    && pacman-key --populate archlinux \
    && pacman -Su --noconfirm \
    && pacman -S --noconfirm --needed \
        base-devel \
        git \
        grub \
        gtk4 \
        libadwaita \
        rust \
        lld \
        nodejs \
        python \
        sudo \
        curl \
        ca-certificates \
        arch-install-scripts \
        dosfstools \
        e2fsprogs \
        erofs-utils \
        libarchive \
        libisoburn \
        mtools \
        squashfs-tools \
    && pacman -Scc --noconfirm

# El nombre exacto (archiso-<ver>-any.pkg.tar.zst) se resuelve al construir
# la imagen para no dejar una versión clavada.
RUN db=$(mktemp) \
    && curl -fsSL -o "$db" https://geo.mirror.pkgbuild.com/extra/os/x86_64/extra.db \
    && fname=$(tar -xOf "$db" --wildcards 'archiso-*/desc' \
        | awk 'f { print; exit } $0 == "%FILENAME%" { f = 1 }') \
    && rm -f "$db" \
    && test -n "$fname" \
    && curl -fsSL -o "/tmp/$fname" "https://geo.mirror.pkgbuild.com/extra/os/x86_64/$fname" \
    && pacman -U --noconfirm "/tmp/$fname" \
    && rm -f "/tmp/$fname" \
    && command -v mkarchiso >/dev/null

# makepkg no corre como root y build.sh llama a sudo (mkarchiso, pacman).
RUN printf '%s\n' 'ALL ALL=(ALL:ALL) NOPASSWD: ALL' > /etc/sudoers.d/churros-builder \
    && chmod 0440 /etc/sudoers.d/churros-builder

WORKDIR /churros
