#!/usr/bin/env bash
# Wrapper to launch XFCE correctly from Greetd
# Flujo: greetd → churros-xfce-session → startx → Xorg → churros-xfce-session --xinit → startxfce4

LOG="/tmp/churros-xfce-session.log"
echo "$(date): churros-xfce-session invoked with args: $*" >> "$LOG"
echo "  DISPLAY=$DISPLAY WAYLAND_DISPLAY=$WAYLAND_DISPLAY XDG_VTNR=$XDG_VTNR" >> "$LOG"

if [ "$1" = "--xinit" ]; then
    echo "$(date): --xinit mode, launching startxfce4 (DISPLAY=$DISPLAY)" >> "$LOG"

    # ====================================================================
    # CRÍTICO: Forzar entorno X11 justo antes de llamar a startxfce4.
    # greetd/PAM/systemd-logind pueden inyectar XDG_SESSION_TYPE=wayland
    # a nivel de sesión (porque el greeter corrió bajo cage/Wayland).
    # Si startxfce4 ve XDG_SESSION_TYPE=wayland o WAYLAND_DISPLAY,
    # intenta arrancar labwc en lugar de usar el Xorg que ya está corriendo.
    # ====================================================================
    unset WAYLAND_DISPLAY
    export XDG_SESSION_TYPE=x11
    export XDG_CURRENT_DESKTOP=XFCE
    export XDG_SESSION_DESKTOP=xfce

    # Forzar el dibujado del cursor por defecto en Xorg para evitar que sea invisible en VMs
    xsetroot -cursor_name left_ptr || true
    exec /usr/bin/startxfce4
fi

# === Fase padre: preparar entorno y lanzar startx ===

# Limpiar variables residuales del greeter Wayland (cage) que confunden a startxfce4
unset WAYLAND_DISPLAY
unset DISPLAY

export XDG_CURRENT_DESKTOP=XFCE
export XDG_SESSION_DESKTOP=xfce
export XDG_SESSION_TYPE=x11

# Determinar el VT que greetd asignó a esta sesión.
# Sin esto, startx/Xorg intentan abrir un VT aleatorio que puede seguir
# ocupado por cage, provocando el crash loop.
VT="${XDG_VTNR:-7}"
echo "$(date): Starting Xorg on vt${VT}" >> "$LOG"

if command -v startx >/dev/null 2>&1; then
    # Esperar a que cage libere el DRM master del VT
    sleep 1
    exec startx "$0" --xinit -- :"${DISPLAY:-0}" "vt${VT}"
else
    exec /usr/bin/startxfce4
fi
