#!/usr/bin/env bash
# Wrapper to launch XFCE correctly from Greetd.
#
# greetd + cage (regreet) runs the greeter on Wayland. When the user logs in,
# greetd kills cage and starts this script. We need to:
#   1. Clean Wayland variables left by cage
#   2. Launch Xorg via startx with -keeptty so Xorg stays on greetd's VT
#      (without it, Xorg detaches → greetd thinks the session died → loop)
#   3. Use the full absolute path as the client program for startx
#      ($0 may be relative, and startx only recognises /absolute paths)

if [ "$1" = "--xinit" ]; then
    # Called back by xinit after Xorg is up — cursor fix for VMs, then XFCE
    xsetroot -cursor_name left_ptr || true
    exec /usr/bin/startxfce4
fi

# Limpiar variables residuales del greeter (Wayland) que confunden a startxfce4
unset WAYLAND_DISPLAY
unset DISPLAY

export XDG_CURRENT_DESKTOP=XFCE
export XDG_SESSION_DESKTOP=xfce
export XDG_SESSION_TYPE=x11

# Esperar a que cage libere el DRM master antes de que Xorg lo reclame
sleep 1

VT_ARG=""
if [ -n "${XDG_VTNR:-}" ]; then
    VT_ARG="vt$XDG_VTNR"
fi

# -keeptty: Xorg permanece en el TTY de greetd en vez de desconectarse.
# vt$XDG_VTNR: Requerido para que Xorg rootless pueda pedir a systemd-logind
# el control del DRM/KMS. Sin esto, Xorg falla al inicializar la gráfica.
exec startx /usr/bin/churros-xfce-session --xinit -- $VT_ARG -keeptty

