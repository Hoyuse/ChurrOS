#!/usr/bin/env bash
#
# churros-update-utils — comprueba y actualiza las utilidades de ChurrOS
# desde el servidor de releases. Se ejecuta como root vía churros-pkexec
# (regla polkit 50-churros-store.rules).
#
# Uso:
#   churros-update-utils
#
# No acepta argumentos: el origen está fijado en este script. Anteriormente
# la GUI pasaba la URL leída de ~/.config/churros/settings.json
# (updates.churros_url), un fichero escribible por el usuario, de modo que
# cualquiera podía hacer que root descargara y extrajera sobre / un tarball
# arbitrario. El sha256 del manifiesto no subsanaba eso: venía del mismo
# origen no autenticado.
#
# Controles aplicados:
#   - origen fijo (https), sin overrides;
#   - versión y nombre de fichero validados con expresiones regulares;
#   - el sha256 announced en el manifiesto debe coincidir con el descargado;
#   - la lista de miembros del tarball se valida antes de extraer (sin rutas
#     absolutas, sin "..", solo prefijos permitidos, sin enlaces simbólicos);
#   - la extracción se hace en un directorio de stage y solo después se
#     copia sobre /.
#
# Si existe /usr/share/churros/churros-release.pubkey, el manifiesto además
# debe venir firmado por minisign y se aborta si la firma no valida.

set -euo pipefail

BASE="https://download.churroslinux.org/churros/"
PUBKEY=/usr/share/churros/churros-release.pubkey

VERSION_FILE=/etc/churros-version
EDITION_FILE=/etc/churros-edition

# Prefios dentro del tarball que el bundle de utilidades puede tocar. Cualquier
# otra ruta (passwd, sudoers, unit de systemd...) se rechaza.
ALLOWED_PREFIXES=(
    usr/bin/
    usr/lib/
    usr/local/bin/
    usr/local/lib/
    usr/share/churros/
    etc/churros-version
    etc/churros-edition
)

die() { printf 'ERROR: %s\n' "$*" >&2; exit 1; }

cleanup() {
    if [ -n "$TMPFILE" ]; then
        rm -f "$TMPFILE" "$TMPFILE.sig"
    fi
    if [ -n "$DL" ]; then
        rm -f "$DL"
    fi
    if [ -n "$STAGE" ]; then
        rm -rf "$STAGE"
    fi
    return 0
}
trap cleanup EXIT

TMPFILE=""
DL=""
STAGE=""

if [ "$#" -ne 0 ]; then
    die "este comando no acepta argumentos (el origen está fijado en $BASE)"
fi

# --------------------------------------------------------------- edición

EDITION="niri"
if [ -f "$EDITION_FILE" ]; then
    EDITION="$(tr -d '[:space:]' < "$EDITION_FILE" | tr '[:upper:]' '[:lower:]')"
elif [ -f /etc/os-release ]; then
    var_id="$(grep -E '^VARIANT_ID=' /etc/os-release | cut -d= -f2 | tr -d '"' | tr -d '[:space:]' || true)"
    [ -n "$var_id" ] && EDITION="$var_id"
fi
# Solo se usa como clave de lookup en el manifiesto: se restringe igual.
case "$EDITION" in
    *[!a-z0-9_-]*) die "edición inválida: $EDITION" ;;
esac

echo "Comprobando utilidades de ChurrOS ($BASE) [edición: $EDITION]..."

# -------------------------------------------------------------- manifiesto

TMPFILE="$(mktemp)"
if command -v minisign >/dev/null 2>&1 && [ -f "$PUBKEY" ]; then
    curl -fsSL --proto '=https' --tlsv1.2 --connect-timeout 10 \
        -o "$TMPFILE.sig" "$BASE/updates.json.minisig" \
        || die "no se pudo obtener la firma minisign del manifiesto"
    minisign -V -p "$PUBKEY" -x "$TMPFILE.sig" -m "$TMPFILE" >/dev/null 2>&1 \
        || die "firma minisig inválida:Updates-JSON no se acepta"
    echo "Firma del manifiesto verificada."
else
    echo "AVISO: sin clave pública de releases ($PUBKEY): el manifiesto solo se"
    echo "       comprueba por integridad (sha256), no por autenticidad."
fi

curl -fsSL --proto '=https' --tlsv1.2 --connect-timeout 10 \
    -o "$TMPFILE" "$BASE/updates.json" || die "no se pudo obtener updates.json"

# La edición se pasa por entorno, no interpolada en el source de python.
PARSED="$(CHURROS_EDITION="$EDITION" python3 -c '
import json, os, re, sys

edition = os.environ["CHURROS_EDITION"]
data = json.load(sys.stdin)

version = data.get("version", "")
if not isinstance(version, str) or not re.fullmatch(r"[0-9]+(\.[0-9]+)*", version):
    sys.exit("version inválida en el manifiesto")

entry = None
editions = data.get("editions")
if isinstance(editions, dict):
    entry = editions.get(edition)
    if entry is None:
        entry = editions.get("niri")
if not isinstance(entry, dict):
    entry = {"file": data.get("file", ""), "sha256": data.get("sha256", "")}

file = entry.get("file", "")
sha = entry.get("sha256", "")
if not isinstance(file, str) or not re.fullmatch(r"[A-Za-z0-9][A-Za-z0-9._-]*\.tar\.zst", file):
    sys.exit("nombre de fichero inválido en el manifiesto")
if not isinstance(sha, str) or not re.fullmatch(r"[0-9a-f]{64}", sha):
    sys.exit("sha256 inválido en el manifiesto")

print(f"{version}|{file}|{sha}")
' < "$TMPFILE")" || die "updates.json mal formado o edición no encontrada"

IFS='|' read -r version file sha256 <<< "$PARSED"

installed="$(cat "$VERSION_FILE" 2>/dev/null || echo "")"

if [ -n "$installed" ] && [ "$version" = "$installed" ]; then
    echo "Utilidades de ChurrOS al día (v$installed)."
    exit 0
fi

# --------------------------------------------------------------- descarga

echo "Actualizando utilidades de ChurrOS: v${installed:-?} -> v$version"
echo "Descargando $file..."

DL="$(mktemp)"
curl -fsSL --proto '=https' --tlsv1.2 --connect-timeout 10 \
    -o "$DL" "$BASE/$file" || die "descarga fallida"

echo "Verificando sha256..."
got="$(sha256sum "$DL" | awk '{print $1}')"
[ "$got" = "$sha256" ] || die "sha256 no coincide ($got != $sha256)"

# ------------------------------------------------- validación del tarball

echo "Validando contenido del paquete..."
listing="$(tar --zstd -tf "$DL")" || die "el paquete no es un tarball válido"

while IFS= read -r member; do
    [ -n "$member" ] || continue
    is_dir=no
    case "$member" in
        */) is_dir=yes ;;
    esac
    case "$member" in
        /*) die "el paquete contiene una ruta absoluta: $member" ;;
        *..*) die "el paquete contiene '..': $member" ;;
        ./*) member="${member#./}" ;;
    esac
    # Entradas de directorio de primer nivel ("." o "./") tras normalizar.
    [ -n "$member" ] || continue
    case "$member" in
        .|*/) member="${member%/}" ;;
    esac
    # Los directorios no se validan contra la lista: los ficheros que hayan
    # dentro sí, y un directorio vacío fuera de ella es inofensivo.
    [ "$member" = "." ] && continue
    [ "$is_dir" = yes ] && continue
    ok=no
    for prefix in "${ALLOWED_PREFIXES[@]}"; do
        case "$member" in
            "$prefix"*) ok=yes; break ;;
        esac
    done
    [ "$ok" = yes ] || die "el paquete toca una ruta no permitida: $member"
done <<< "$listing"

# Sin enlaces simbólicos ni duros: un bundle de utilidades no los necesita y
# un enlace a /etc/shadow convertiría la extracción en escritura arbitraria.
# El listado se materializa antes de filtrar para no depender de SIGPIPE.
verbose_listing="$(tar --zstd -tvf "$DL")"
case "$verbose_listing" in
    [lh]* | *'
'[lh]*)
        die "el paquete contiene enlaces simbólicos o duros"
        ;;
esac

# --------------------------------------------------------------- instalar

STAGE="$(mktemp -d /run/churros-update.XXXXXX)"
# Root restaura los permisos del archivo (no --no-same-permissions): los
# binarios del bundle necesitan su bit +x intacto.
tar --zstd -xf "$DL" -C "$STAGE" --no-same-owner \
    || die "fallo al extraer el paquete"

# Segunda barrera: el stage solo puede contener lo autorizado y nada que
# escapes de él.
while IFS= read -r path; do
    rel="${path#"$STAGE"/}"
    case "$rel" in
        /*|*..*) die "extracción fuera del stage: $rel" ;;
    esac
done < <(find "$STAGE" -mindepth 1)

echo "Instalando..."
# cp -a preserva permisos/owner de los ficheros del bundle, pero también
# copia los atributos del propio $STAGE: mktemp lo crea con modo 0700 y eso
# dejaría / con permisos 0700. Restaurar / a 755 tras la copia.
cp -a "$STAGE"/. /
chmod 755 /

# Solo tras copiar se actualiza la versión instalada.
if ! printf '%s\n' "$version" | cmp -s - "$VERSION_FILE"; then
    printf '%s\n' "$version" > "$VERSION_FILE"
fi

cleanup
TMPFILE=""
DL=""
STAGE=""

echo "Utilidades de ChurrOS actualizadas a v$version."