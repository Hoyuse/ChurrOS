#!/usr/bin/env bash
#
# churros-update-utils — comprueba y actualiza las utilidades de ChurrOS
# desde el servidor de releases. Se ejecuta como root vía churros-pkexec
# (la regla polkit permite los binarios churros-*).
#
# Uso:
#   churros-update-utils [URL_BASE]
#
# URL_BASE por defecto: https://download.churroslinux.org/churros/
#

set -e

BASE="${1:-https://download.churroslinux.org/churros/}"
BASE="${BASE%/}/"
ARCH="$(uname -m)"

case "$ARCH" in
    x86_64|aarch64) ;;
    *)
        echo "ERROR: arquitectura no soportada: $ARCH"
        exit 1
        ;;
esac

VERSION_FILE=/etc/churros-version
EDITION_FILE=/etc/churros-edition
EDITION="niri"
if [ -f "$EDITION_FILE" ]; then
    EDITION="$(tr -d '[:space:]' < "$EDITION_FILE" | tr '[:upper:]' '[:lower:]')"
elif [ -f /etc/os-release ]; then
    var_id=$(grep -E '^VARIANT_ID=' /etc/os-release | cut -d= -f2 | tr -d '"' | tr -d '[:space:]' || true)
    [ -n "$var_id" ] && EDITION="$var_id"
fi

MANIFEST_URL="${BASE}${ARCH}/updates.json"
echo "Comprobando utilidades de ChurrOS ($MANIFEST_URL) [edición: $EDITION]..."

MANIFEST="$(curl -fsSL --connect-timeout 10 "$MANIFEST_URL" 2>/dev/null)" || {
    echo "ERROR: no se pudo obtener updates.json"
    exit 1
}

PARSED=$(python3 -c "
import sys, json
try:
    manifest_raw = sys.stdin.read()
    data = json.loads(manifest_raw)
    version = data.get('version', '')
    expected_arch = '$ARCH'
    if data.get('arch') != expected_arch:
        sys.exit(2)
    edition = '$EDITION'
    editions = data.get('editions', {})
    if isinstance(editions, dict) and edition in editions:
        file = editions[edition].get('file', '')
        sha = editions[edition].get('sha256', '')
    elif isinstance(editions, dict) and 'niri' in editions:
        file = editions['niri'].get('file', '')
        sha = editions['niri'].get('sha256', '')
    else:
        file = data.get('file', '')
        sha = data.get('sha256', '')
    print(f'{version}|{file}|{sha}')
except Exception:
    sys.exit(1)
" <<< "$MANIFEST" 2>/dev/null || true)

IFS='|' read -r version file sha256 <<< "$PARSED"

[ -n "$version" ] && [ -n "$file" ] && [ -n "$sha256" ] || {
    echo "ERROR: updates.json mal formado o edición no encontrada"
    exit 1
}

installed="$(cat "$VERSION_FILE" 2>/dev/null || echo "")"

if [ -n "$installed" ] && [ "$version" = "$installed" ]; then
    echo "Utilidades de ChurrOS al día (v$installed)."
    exit 0
fi

echo "Actualizando utilidades de ChurrOS: v${installed:-?} -> v$version"
echo "Descargando $file..."
tmp="$(mktemp)"
curl -fSL --connect-timeout 10 -o "$tmp" "$BASE/$file" || {
    echo "ERROR: descarga fallida"
    rm -f "$tmp"
    exit 1
}

echo "Verificando sha256..."
got="$(sha256sum "$tmp" | awk '{print $1}')"
if [ "$got" != "$sha256" ]; then
    echo "ERROR: sha256 no coincide ($got != $sha256)"
    rm -f "$tmp"
    exit 1
fi

echo "Instalando..."
tar --zstd -xaf "$tmp" -C / --no-same-owner
rm -f "$tmp"

echo "Utilidades de ChurrOS actualizadas a v$version."
