#!/usr/bin/env bash
# Wrapper to launch XFCE correctly from Greetd

# Registro de diagnóstico: se vacía al empezar cada inicio de sesión (la
# invocación interna --xinit añade al mismo fichero) para que no crezca sin fin.
LOGFILE="${HOME:-/tmp}/.xsession-errors"
if [ "${1:-}" = "--xinit" ]; then
    { exec >> "$LOGFILE"; } 2>/dev/null && exec 2>&1
else
    { exec > "$LOGFILE"; } 2>/dev/null && exec 2>&1
fi
echo "=== churros-xfce-session: start $(date) (pid=$$, arg1='${1:-}', DISPLAY='${DISPLAY:-}', WAYLAND='${WAYLAND_DISPLAY:-}') ==="

export XCURSOR_THEME="${XCURSOR_THEME:-Adwaita}"
export XCURSOR_SIZE="${XCURSOR_SIZE:-24}"
export XDG_CURRENT_DESKTOP=XFCE
export XDG_SESSION_DESKTOP=xfce
export XDG_SESSION_TYPE=x11
export DESKTOP_SESSION=xfce

# ¿Ya hay un servidor X? Pasa con nuestro propio startx (--xinit) y también
# cuando ReGreet lanza la sesión X11: antepone su x11_prefix por defecto
# ("startx /usr/bin/env") al Exec de xfce.desktop. Lanzar otro startx aquí
# fallaría ("Server is already active for display 0") y devolvería al greeter.
x_running() {
    [ -n "${DISPLAY:-}" ] || return 1
    command -v xset >/dev/null 2>&1 || return 0
    xset q >/dev/null 2>&1
}

if [ "${1:-}" = "--xinit" ] || x_running; then
    # startxfce4 (4.20) solo busca labwc con --wayland, que exporta
    # XFCE4_SESSION_COMPOSITOR. Sin esa variable y con DISPLAY puesto ejecuta
    # /etc/xdg/xfce4/xinitrc: XDG_MENU_PREFIX=xfce- (menú de aplicaciones),
    # xrdb (Xft/Xcursor), dbus-update-activation-environment --systemd y por
    # último xfce4-session. No cambiarlo por xfce4-session a secas.
    # Tampoco cargar /etc/X11/xinit/xinitrc: acaba en 'exec xterm' (exit 127).
    unset WAYLAND_DISPLAY XFCE4_SESSION_COMPOSITOR

    # Forzar el dibujado del cursor por defecto en Xorg para evitar que sea invisible en VMs
    xsetroot -cursor_name left_ptr || true
    exec /usr/bin/startxfce4
fi

# Limpiar variables residuales del greeter (Wayland) que confunden a startx
unset WAYLAND_DISPLAY XFCE4_SESSION_COMPOSITOR
unset DISPLAY

# Xorg en el VT que greetd asignó a la sesión. Sin ":N": startx elige el primer
# display libre, así un /tmp/.X0-lock viejo no tumba el arranque.
VT="${XDG_VTNR:-7}"

if command -v startx >/dev/null 2>&1; then
    # Esperar un segundo para permitir que cage libere el DRM master antes de que Xorg lo reclame
    sleep 1
    exec startx "$0" --xinit -- "vt${VT}" -keeptty
else
    exec /usr/bin/startxfce4
fi
